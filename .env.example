# Backend (FastAPI) settings. Copy to `.env` (optional: these are the defaults).
# Only the keys below are accepted in this file (see src/api/config.py).

# SQLite (default, zero setup). For PostgreSQL use e.g.:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/back2u
DATABASE_URL=sqlite:///./app.db

# Where the backend reaches the ML inference service.
ML_SERVICE_URL=http://127.0.0.1:8001

ENVIRONMENT=development
